    },
    "Want to move to the next category?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите перейти в следующую категорию?"
          }
        }
      }
    },
    "We ensure a fair system:\n• Ratings are anonymous\n• Max 2 ratings from the same player in 60 days\n• Light has minimal impact on Hard and Pro levels\n• Pro levels are harder to reach\nPlay fair — your level will speak for itself." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы гарантируем честную систему:\n• Рейтинги анонимны\n• Максимум 2 рейтинга от одного игрока за 60 дней\n• Уровень Light минимально влияет на уровни Hard и Pro\n• Уровень Pro сложнее достичь\nИграйте честно — ваш уровень будет говорить сам за себя."
          }
        }
      }
    },
    "welcome_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app helps you find beach volleyball games and match with players at your skill level."
