{
  "sourceLanguage" : "en",
  "strings" : {
    "authError.emm" : {
      "comment" : "Error message for the EMM (Enterprise Mobility Management) user",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google authentication error. Try signing out and signing back in, or check your app settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка аутентификации с Google. Попробуйте выйти и войти снова или проверьте настройки приложения."
          }
        }
      }
    },
